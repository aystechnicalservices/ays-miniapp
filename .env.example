# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram numeric user ID (the boss).
BOSS_ID=

# Chat ID of the private channel/group the bot relays photos/videos into (needed
# to get a Telegram file_id — see README). Create a private channel, add the bot
# as admin, post any message, and check the bot's logs for the chat_id.
STORAGE_CHAT_ID=

# Extra Telegram user IDs also allowed into the boss library view (comma-separated).
EXTRA_BOSS_IDS=

# Telegram user IDs that get the "WORK PLAN FOR ..." message when a plan is sent
# (comma-separated).
CREW_IDS=

# Set to 1 to temporarily lock the crew out (bosses keep full access) while
# rearranging plans mid-day. Crew see "The work plan is being updated..." and
# don't get notified about plans sent during it. Editing the library alone
# never affects workers, so this is only needed when testing plan sends.
MAINTENANCE_MODE=

# IANA timezone name used for "today's date" in worker notifications and for
# resolving "send at HH:MM".
TIMEZONE=Asia/Dubai

# Public HTTPS base URL where this server is reachable (e.g. your ngrok URL).
# Used only to print the Mini App URL to register with BotFather at startup.
PUBLIC_URL=

# Local host/port the server listens on
HOST=0.0.0.0
PORT=8000
