# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram numeric user ID (the boss).
BOSS_ID=

# Chat ID of the private channel/group the bot relays photos/videos into (needed
# to get a Telegram file_id — see README). Create a private channel, add the bot
# as admin, post any message, and check the bot's logs for the chat_id.
STORAGE_CHAT_ID=

# Chat ID of a private channel the bot posts the end-of-day report to (same
# setup as STORAGE_CHAT_ID above: create a channel, add the bot as admin,
# check the logs for the chat_id). Optional — the report just skips itself
# (with a log warning) until this is set.
REPORTS_CHAT_ID=

# API key from Google AI Studio (aistudio.google.com) for the AI features
# (library item drafting, report prose, plan drafting). Server-side only —
# never sent to the frontend. Optional — those features just fall back to
# plain non-AI behavior until this is set; nothing else depends on it.
GEMINI_API_KEY=

# Extra Telegram user IDs also allowed into the boss library view (comma-separated).
EXTRA_BOSS_IDS=

# Telegram user IDs that get the "Work Plan ..." message when a plan is sent
# (comma-separated).
CREW_IDS=

# IANA timezone name used for "today's date" in worker/report notifications
# and for what "today"/"tomorrow" mean in the library.
TIMEZONE=Asia/Dubai

# Public HTTPS base URL where this server is reachable (e.g. your Tailscale
# Funnel address — see README). Used to print/register the Mini App URL.
PUBLIC_URL=

# Local host/port the server listens on
HOST=0.0.0.0
PORT=8000
